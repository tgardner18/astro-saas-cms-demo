---
import type { ContentPayload } from '../../../graphql/shared/ContentPayload';
import type { CompositionStructureNode } from '../../../../__generated/sdk';
import Elements from '../../components/_Components.astro';
import { getCarouselRowStyleConfig } from './CarouselRowStyling';

export interface Props {
    row: any;
    contentPayload: ContentPayload;
}
const { row, contentPayload } = Astro.props as Props;

// Flatten all items from columns into a single array
let items: any[] = [];
row.nodes?.map((column: any) => {
    column.nodes?.map((item: any) => {
        items.push(item);
    });
});

// Get carousel configuration from display settings
const rowNode = row as CompositionStructureNode;
const styleConfig = getCarouselRowStyleConfig((rowNode.displaySettings || []) as any);
const isContentCarousel = styleConfig.carouselMode === 'content';

// Create a unique ID for this specific carousel instance
const carouselId = `carousel-row-${Math.random().toString(36).substring(2, 9)}`;
const paginationId = `${carouselId}-pagination`;
---

<!--
    The outer wrapper breaks out of any Section/Row padding via the
    full-bleed technique (100vw + left: 50% + margin-left: -50vw).
    body { overflow-x: hidden } in global.css prevents a scrollbar.
-->
<div class="carousel-row-outer-wrapper">
    <section
        id={carouselId}
        class={`splide ${isContentCarousel ? 'content-carousel' : 'standard-carousel'} ${styleConfig.carouselHeight} ${styleConfig.carouselWidth}`}
        aria-label="Carousel Row"
        data-pagination-id={paginationId}
        data-content-mode={isContentCarousel ? 'true' : 'false'}
        data-show-arrows={styleConfig.showNavigation.toString()}
        data-show-pagination={styleConfig.showPagination.toString()}
        data-autoplay={styleConfig.enableAutoplay.toString()}
        data-autoplay-delay={styleConfig.autoplayDelay.toString()}
        data-loop={styleConfig.enableLoop.toString()}
        data-items-desktop={styleConfig.itemsPerViewDesktop.toString()}
        data-items-tablet={styleConfig.itemsPerViewTablet.toString()}
        data-items-mobile={styleConfig.itemsPerViewMobile.toString()}
        data-space-between={styleConfig.spaceBetween.toString()}
        data-transition-speed={styleConfig.transitionSpeed.toString()}
    >
        <div class="splide__track">
            <ul class="splide__list">
                {
                    items?.map((item: any) => (
                        <li class={`splide__slide ${styleConfig.carouselHeight}`}>
                            <div class={`carousel-row-slide-content w-full h-full ${isContentCarousel ? 'p-2' : ''}`}>
                                <Elements contentPayload={contentPayload} data={item} />
                            </div>
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <!-- External pagination rendered below the carousel -->
    <div
        id={paginationId}
        class="carousel-external-dots"
        role="tablist"
        aria-label="Carousel navigation"
    ></div>
</div>

<style>
    /* ── Full-bleed: escape Section (p-2 sm:p-3 md:p-4) and Row (p-1) padding ── */
    .carousel-row-outer-wrapper {
        position: relative;
        width: 100vw;
        left: 50%;
        margin-left: -50vw;
        overflow-x: hidden;
    }

    /* ── Splide base ── */
    .splide {
        width: 100% !important;
    }

    .splide__track,
    .splide__list {
        height: 100%;
        width: 100%;
    }

    .splide__slide {
        height: auto;
    }

    /* ── Standard carousel (full-image hero slides) ── */
    .standard-carousel .splide__slide {
        display: flex;
        align-items: stretch;
        /* Responsive height: scales with viewport, capped top and bottom */
        min-height: clamp(260px, 38vw, 560px);
    }

    .standard-carousel .carousel-row-slide-content {
        display: flex;
        width: 100%;
        height: 100%;
    }

    /* ── Content carousel (card/multi-item) ── */
    .content-carousel .splide__slide {
        display: flex !important;
        align-items: stretch;
    }

    .content-carousel .carousel-row-slide-content {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
    }

    .content-carousel .carousel-row-slide-content > :global(*) {
        flex: 1;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .content-carousel .carousel-row-slide-content > :global(section) {
        height: 100%;
    }

    /* ── Arrows: flush to left/right edges, subtle light-gray ── */
    :global(.splide__arrow) {
        background: rgba(210, 210, 210, 0.88) !important;
        border: none !important;
        border-radius: 2px !important;
        width: 2.25rem !important;
        height: 3.25rem !important;
        z-index: 20;
        opacity: 1 !important;
        transition: background 0.2s ease !important;
    }

    :global(.splide__arrow--prev) {
        left: 0 !important;
    }

    :global(.splide__arrow--next) {
        right: 0 !important;
    }

    :global(.splide__arrow svg) {
        fill: #444 !important;
        width: 0.875rem !important;
        height: 0.875rem !important;
    }

    :global(.splide__arrow:hover) {
        background: rgba(190, 190, 190, 0.98) !important;
    }

    /* ── Hero inside standard carousel: anchor to bottom-left ── */
    :global(.standard-carousel .component-hero) {
        align-items: flex-end !important;
    }

    /* Replace full-image overlay with a readable gradient bar at the bottom */
    :global(.standard-carousel .hero-overlay) {
        background-color: transparent !important;
        background-image: linear-gradient(
            to top,
            rgba(0, 0, 0, 0.75) 0%,
            rgba(0, 0, 0, 0.48) 38%,
            transparent 68%
        ) !important;
    }

    /* Content block: bottom-left, reasonable max-width */
    :global(.standard-carousel .hero-content) {
        width: 100% !important;
        max-width: 58% !important;
        padding-bottom: 2.5rem !important;
        padding-left: 2rem !important;
        padding-right: 1rem !important;
    }

    /* Responsive heading size */
    :global(.standard-carousel .component-hero h1) {
        font-size: clamp(1.4rem, 3.8vw, 3.5rem) !important;
        line-height: 1.1 !important;
    }

    /* Mobile: wider content block, tighter padding */
    @media (max-width: 640px) {
        :global(.standard-carousel .hero-content) {
            max-width: 88% !important;
            padding-left: 1rem !important;
            padding-bottom: 1.25rem !important;
        }

        .standard-carousel .splide__slide {
            min-height: 220px;
        }
    }

    /* ── External pagination dots below carousel ── */
    .carousel-external-dots {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        padding: 0.875rem 0;
    }

    .carousel-external-dots:empty {
        display: none;
    }

    .carousel-external-dots :global(.carousel-dot) {
        width: 0.75rem;
        height: 0.75rem;
        border-radius: 50%;
        background: color-mix(in oklch, var(--color-primary) 38%, transparent);
        border: none;
        cursor: pointer;
        padding: 0;
        transition: background 0.2s ease, transform 0.2s ease;
    }

    .carousel-external-dots :global(.carousel-dot.is-active) {
        background: var(--color-primary);
        transform: scale(1.3);
    }

    .carousel-external-dots :global(.carousel-dot:hover) {
        background: color-mix(in oklch, var(--color-primary) 65%, transparent);
    }

    /* Cards/sections inside slides fill height */
    .splide__slide :global(.card),
    .splide__slide :global(.section) {
        height: 100%;
    }
</style>

<!-- Splide CSS -->
<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css"
/>

<!-- Splide JS -->
<script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js"></script>

<script>
    document.addEventListener('astro:page-load', function () {
        const carousels = document.querySelectorAll('.splide');

        carousels.forEach((carousel) => {
            if ((carousel as any).splide) return;

            const paginationId = carousel.getAttribute('data-pagination-id');
            const dotsContainer = paginationId ? document.getElementById(paginationId) : null;

            const isContentMode = carousel.getAttribute('data-content-mode') === 'true';
            const showArrows    = carousel.getAttribute('data-show-arrows') === 'true';
            const showPagination = carousel.getAttribute('data-show-pagination') === 'true';
            const enableAutoplay = carousel.getAttribute('data-autoplay') === 'true';
            const autoplayDelay  = parseInt(carousel.getAttribute('data-autoplay-delay') || '5000');
            const enableLoop     = carousel.getAttribute('data-loop') === 'true';
            const transitionSpeed = parseInt(carousel.getAttribute('data-transition-speed') || '500');

            const itemsDesktop  = parseInt(carousel.getAttribute('data-items-desktop') || '3');
            const itemsTablet   = parseInt(carousel.getAttribute('data-items-tablet') || '2');
            const itemsMobile   = parseInt(carousel.getAttribute('data-items-mobile') || '1');
            const spaceBetween  = parseInt(carousel.getAttribute('data-space-between') || '24');

            const config: any = {
                type: enableLoop ? 'loop' : 'slide',
                arrows: showArrows,
                pagination: false, // using external dots
                autoplay: enableAutoplay,
                interval: autoplayDelay,
                pauseOnHover: true,
                pauseOnFocus: true,
                speed: transitionSpeed,
                easing: 'ease-in-out',
                updateOnMove: true,
            };

            if (isContentMode) {
                config.perPage = itemsDesktop;
                config.gap = `${spaceBetween}px`;
                config.breakpoints = {
                    1023: { perPage: itemsTablet, gap: `${spaceBetween}px` },
                    767:  { perPage: itemsMobile, gap: `${spaceBetween}px` },
                };
                config.height = 'auto';
                config.heightRatio = 0;
                config.fixedHeight = false;
            } else {
                config.perPage = 1;
                config.gap = 0;
                config.height = 'auto';
                config.heightRatio = 0;
            }

            if (typeof (window as any).Splide === 'undefined') {
                console.error('Splide is not loaded');
                return;
            }

            const splideInstance = new (window as any).Splide(carousel, config);

            // Build external dot pagination
            if (dotsContainer && showPagination) {
                splideInstance.on('mounted', () => {
                    const count = splideInstance.length;
                    dotsContainer.innerHTML = '';
                    for (let i = 0; i < count; i++) {
                        const dot = document.createElement('button');
                        dot.setAttribute('role', 'tab');
                        dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
                        dot.classList.add('carousel-dot');
                        if (i === 0) dot.classList.add('is-active');
                        dot.addEventListener('click', () => splideInstance.go(i));
                        dotsContainer.appendChild(dot);
                    }
                });

                splideInstance.on('moved', (newIndex: number) => {
                    dotsContainer.querySelectorAll('.carousel-dot').forEach((dot, i) => {
                        dot.classList.toggle('is-active', i === newIndex);
                    });
                });
            } else if (dotsContainer) {
                dotsContainer.style.display = 'none';
            }

            splideInstance.mount();
        });
    });
</script>
