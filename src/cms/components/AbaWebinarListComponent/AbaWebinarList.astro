---
import type {
    AbaWebinarListFragment,
    AbaWebinarExcerptFragment,
    DisplaySettingsFragment,
} from '../../../../__generated/sdk';
import { getOptimizelySdk } from '../../../graphql/getSdk';
import type { ContentPayload } from '../../../graphql/shared/ContentPayload';
import { getDictionaryFromDisplaySettings } from '../../../graphql/shared/displaySettingsHelpers';
import { isEditContext } from '../../shared/utils.ts';

const isCmsEdit = isEditContext(Astro.url);

export interface Props {
    key: string;
    data: AbaWebinarListFragment;
    displaySettings: DisplaySettingsFragment[];
    displayTemplateKey: string;
    contentPayload: ContentPayload;
}

const { key, data, displaySettings, contentPayload } = Astro.props as Props;

const currentSite = data.WebinarRoot?.url?.base
    ? data.WebinarRoot.url.base
    : Astro.url.origin;

const webinarsList = await getOptimizelySdk(contentPayload).getAbaWebinars({
    //@ts-ignore
    loc: contentPayload.loc,
    site: currentSite,
    limit: data.NumberOfWebinars || 100,
    rootUrl: data.WebinarRoot?.url?.default || '/',
});

const now = new Date();
const allItems = (webinarsList.AbaWebinarPage?.items ?? []) as AbaWebinarExcerptFragment[];

const monthFmt = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', month: 'short' });
const dayFmt   = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', day: 'numeric' });
const timeFmt  = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', hour: 'numeric', minute: '2-digit', hour12: true });

const serializedItems = allItems
    .filter((item) => {
        if (!data.ShowUpcomingOnly) return true;
        const start = item.StartDateTime ? new Date(item.StartDateTime as string) : null;
        return start ? start >= now : true;
    })
    .map((item) => {
        const startDate = item.StartDateTime ? new Date(item.StartDateTime as string) : null;
        const endDate   = item.EndDateTime   ? new Date(item.EndDateTime as string)   : null;
        const meta = item._metadata as any;
        return {
            title:     item.WebinarTitle ?? meta?.displayName ?? '',
            url:       ((meta?.url?.base ?? '') + (meta?.url?.hierarchical ?? '')) || '#',
            month:     startDate ? monthFmt.format(startDate).toUpperCase() : '',
            day:       startDate ? dayFmt.format(startDate) : '',
            startTime: startDate ? timeFmt.format(startDate) : '',
            endTime:   endDate   ? timeFmt.format(endDate)   : '',
            credits:    (item.CeCreditsAvailable ?? []).filter(c => c && c !== 'notApplicable') as string[],
            noCredits:  (item.CeCreditsAvailable ?? []).some(c => c === 'notApplicable'),
            audience:   (item.Audience ?? []).filter(Boolean) as string[],
            memberOnly: item.Restrictions === 'bankMember',
        };
    });

// Display settings
const styleDictionary = getDictionaryFromDisplaySettings(displaySettings);
const maxWidth = styleDictionary['maxWidth'] || 'none';
const contentAlignment = styleDictionary['contentAlignment'] || 'left';

const containerClasses = {
    'max-w-4xl': maxWidth === 'tw_4xl',
    'max-w-5xl': maxWidth === 'tw_5xl',
    'max-w-6xl': maxWidth === 'tw_6xl',
    'max-w-7xl': maxWidth === 'tw_7xl',
    'mx-auto':   contentAlignment === 'center',
};

const componentClass = 'component-aba-webinar-list';
---

<div data-epi-block-id={isCmsEdit && key || undefined} class={componentClass}>
    <div class:list={[containerClasses]}>

        {data.Title && (
            <h2
                class="text-2xl font-bold text-base-content mb-6"
                data-epi-edit={isCmsEdit ? 'Title' : undefined}
            >
                {data.Title}
            </h2>
        )}

        <div
            x-data="abaWebinarList"
            data-webinars={JSON.stringify(serializedItems)}
        >
            <!-- Filter bar -->
            <div class="flex flex-wrap items-center gap-2 mb-5">

                <!-- Audience filter -->
                <div class="relative" x-show="allAudiences.length > 0">
                    <button
                        type="button"
                        class="btn btn-outline btn-sm gap-1.5 rounded-full"
                        :class="{ 'btn-primary': selectedAudience.length > 0 }"
                        @click="audienceOpen = !audienceOpen; creditsOpen = false"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        Audience
                        <span x-show="selectedAudience.length > 0" class="badge badge-sm badge-primary text-primary-content font-bold" x-text="selectedAudience.length"></span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 transition-transform duration-150" :class="{ 'rotate-180': audienceOpen }" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>
                    <div
                        x-show="audienceOpen"
                        x-cloak
                        @click.away="audienceOpen = false"
                        class="absolute left-0 top-full mt-1.5 z-20 bg-base-100 border border-base-200 rounded-2xl shadow-xl p-2 min-w-56"
                    >
                        <template x-for="val in allAudiences" :key="val">
                            <label class="flex items-center gap-2.5 px-3 py-2 rounded-lg cursor-pointer hover:bg-base-200 transition-colors">
                                <input
                                    type="checkbox"
                                    class="checkbox checkbox-primary checkbox-xs"
                                    :checked="selectedAudience.includes(val)"
                                    @change="toggleAudience(val)"
                                />
                                <span class="text-sm text-base-content leading-snug" x-text="val"></span>
                            </label>
                        </template>
                    </div>
                </div>

                <!-- Credits filter -->
                <div class="relative" x-show="allCredits.length > 0">
                    <button
                        type="button"
                        class="btn btn-outline btn-sm gap-1.5 rounded-full"
                        :class="{ 'btn-primary': selectedCredits.length > 0 }"
                        @click="creditsOpen = !creditsOpen; audienceOpen = false"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                        </svg>
                        Credits Available
                        <span x-show="selectedCredits.length > 0" class="badge badge-sm badge-primary text-primary-content font-bold" x-text="selectedCredits.length"></span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 transition-transform duration-150" :class="{ 'rotate-180': creditsOpen }" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>
                    <div
                        x-show="creditsOpen"
                        x-cloak
                        @click.away="creditsOpen = false"
                        class="absolute left-0 top-full mt-1.5 z-20 bg-base-100 border border-base-200 rounded-2xl shadow-xl p-2 min-w-44"
                    >
                        <template x-for="val in allCredits" :key="val">
                            <label class="flex items-center gap-2.5 px-3 py-2 rounded-lg cursor-pointer hover:bg-base-200 transition-colors">
                                <input
                                    type="checkbox"
                                    class="checkbox checkbox-primary checkbox-xs"
                                    :checked="selectedCredits.includes(val)"
                                    @change="toggleCredit(val)"
                                />
                                <span class="text-sm text-base-content font-medium" x-text="val"></span>
                            </label>
                        </template>
                    </div>
                </div>

                <!-- Active filter chips -->
                <template x-for="val in selectedAudience" :key="'a-'+val">
                    <span class="badge badge-primary gap-1 rounded-full py-2.5 pr-1 pl-3 text-xs font-medium">
                        <span x-text="val"></span>
                        <button type="button" @click="toggleAudience(val)" class="btn btn-ghost btn-xs btn-circle ml-0.5 h-4 w-4 min-h-0 p-0 hover:bg-primary-focus/20">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </span>
                </template>
                <template x-for="val in selectedCredits" :key="'c-'+val">
                    <span class="badge badge-primary gap-1 rounded-full py-2.5 pr-1 pl-3 text-xs font-medium">
                        <span x-text="val"></span>
                        <button type="button" @click="toggleCredit(val)" class="btn btn-ghost btn-xs btn-circle ml-0.5 h-4 w-4 min-h-0 p-0 hover:bg-primary-focus/20">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </span>
                </template>

                <!-- Clear all -->
                <button
                    type="button"
                    x-show="selectedAudience.length > 0 || selectedCredits.length > 0"
                    x-cloak
                    @click="clearAll()"
                    class="btn btn-ghost btn-xs text-error/80 hover:text-error ml-1"
                >
                    Clear all
                </button>
            </div>

            <!-- Result count -->
            <p class="text-xs text-base-content/40 uppercase tracking-wider font-semibold mb-3">
                <span x-text="filteredWebinars.length"></span>
                <span x-show="filteredWebinars.length === 1"> webinar</span>
                <span x-show="filteredWebinars.length !== 1"> webinars</span>
            </p>

            <!-- Webinar list -->
            <div class="space-y-3">

                <!-- Items -->
                <template x-for="(webinar, idx) in filteredWebinars" :key="webinar.url + idx">
                    <div class="flex items-center gap-4 sm:gap-5 px-4 sm:px-5 py-4 bg-base-100 rounded-xl border border-base-200 shadow-sm hover:shadow-md transition-shadow duration-150 group">

                        <!-- Date badge -->
                        <div class="flex-shrink-0 w-12 text-center select-none">
                            <div class="rounded-xl bg-primary/8 px-1 py-1.5">
                                <span class="block text-[10px] font-bold text-primary/60 uppercase tracking-widest leading-none mb-0.5" x-text="webinar.month"></span>
                                <span class="block text-xl font-black text-primary leading-none" x-text="webinar.day"></span>
                            </div>
                        </div>

                        <!-- Main: title + credits -->
                        <div class="flex-1 min-w-0">
                            <a
                                :href="webinar.url"
                                class="text-base sm:text-lg font-semibold text-primary hover:underline leading-snug line-clamp-2 group-hover:text-primary/80 transition-colors"
                                x-text="webinar.title"
                            ></a>
                            <div class="flex flex-wrap items-center gap-1.5 mt-1.5">
                                <template x-if="webinar.memberOnly">
                                    <span class="inline-flex items-center rounded-full bg-amber-50 border border-amber-200 px-2.5 py-0.5 text-xs font-semibold text-amber-700">Member Only</span>
                                </template>
                                <template x-if="webinar.noCredits && webinar.credits.length === 0">
                                    <span class="text-xs text-base-content/40 italic">Credits not available</span>
                                </template>
                                <template x-if="!webinar.noCredits && webinar.credits.length === 0">
                                    <span class="text-xs text-base-content/40 italic">Credits not available</span>
                                </template>
                                <template x-for="credit in webinar.credits" :key="credit">
                                    <span
                                        class="inline-flex items-center rounded-md bg-base-200 px-2 py-0.5 text-xs font-semibold text-base-content/70"
                                        x-text="credit + ' available'"
                                    ></span>
                                </template>
                            </div>
                        </div>

                        <!-- Time -->
                        <div class="flex-shrink-0 text-right hidden sm:block">
                            <template x-if="webinar.startTime">
                                <span class="block text-sm font-medium text-base-content/70 whitespace-nowrap" x-text="webinar.startTime + (webinar.endTime ? '–' + webinar.endTime : '') + ' ET'"></span>
                            </template>
                            <template x-if="!webinar.startTime">
                                <span class="text-xs text-base-content/30">TBD</span>
                            </template>
                        </div>

                        <!-- Time (mobile) -->
                        <div class="flex-shrink-0 text-right sm:hidden">
                            <template x-if="webinar.startTime">
                                <span class="text-xs font-medium text-base-content/60 whitespace-nowrap" x-text="webinar.startTime"></span>
                            </template>
                        </div>

                    </div>
                </template>

                <!-- Empty state -->
                <template x-if="filteredWebinars.length === 0">
                    <div class="py-14 px-6 text-center bg-base-100">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 mx-auto text-base-content/20 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        <p class="text-base-content/50 font-medium mb-4">No webinars match your filters.</p>
                        <button type="button" @click="clearAll()" class="btn btn-outline btn-sm rounded-full">Clear filters</button>
                    </div>
                </template>

            </div>
        </div>

    </div>
</div>

<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('abaWebinarList', () => ({
        allWebinars: [],
        selectedAudience: [],
        selectedCredits: [],
        audienceOpen: false,
        creditsOpen: false,

        init() {
            this.allWebinars = JSON.parse(this.$el.getAttribute('data-webinars') || '[]');
        },

        get allAudiences() {
            const s = new Set();
            this.allWebinars.forEach(w => w.audience?.forEach(a => a && s.add(a)));
            return [...s].sort();
        },

        get allCredits() {
            const s = new Set();
            this.allWebinars.forEach(w => w.credits?.forEach(c => c && s.add(c)));
            return [...s].sort();
        },

        get filteredWebinars() {
            return this.allWebinars.filter(w => {
                const aMatch = this.selectedAudience.length === 0
                    || w.audience?.some(a => this.selectedAudience.includes(a));
                const cMatch = this.selectedCredits.length === 0
                    || w.credits?.some(c => this.selectedCredits.includes(c));
                return aMatch && cMatch;
            });
        },

        toggleAudience(val) {
            const i = this.selectedAudience.indexOf(val);
            if (i === -1) this.selectedAudience.push(val);
            else this.selectedAudience.splice(i, 1);
        },

        toggleCredit(val) {
            const i = this.selectedCredits.indexOf(val);
            if (i === -1) this.selectedCredits.push(val);
            else this.selectedCredits.splice(i, 1);
        },

        clearAll() {
            this.selectedAudience = [];
            this.selectedCredits = [];
            this.audienceOpen = false;
            this.creditsOpen = false;
        },
    }));
});
</script>
