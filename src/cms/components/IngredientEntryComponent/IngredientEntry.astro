---
import type {
    IngredientEntryFragment,
    DisplaySettingsFragment,
} from '../../../../__generated/sdk';
import type { ContentPayload } from '../../../graphql/shared/ContentPayload';
import { isEditContext } from '../../shared/utils.ts';
import { getDictionaryFromDisplaySettings } from '../../../graphql/shared/displaySettingsHelpers.ts';

const isCmsEdit = isEditContext(Astro.url);

export interface Props {
    key: string;
    data: IngredientEntryFragment;
    displaySettings: DisplaySettingsFragment[];
    displayTemplateKey: string;
    contentPayload: ContentPayload;
}

const { key, data, displaySettings } = Astro.props as Props;

const settings = getDictionaryFromDisplaySettings(displaySettings);
const isCard = settings?.layout === 'card';
const showBorder = settings?.showBorder !== 'false';

const componentClass = 'component-ingredient-entry';
---

<div
    data-epi-block-id={isCmsEdit && key || undefined}
    class:list={[
        componentClass,
        isCard
            ? 'card bg-base-100 shadow-sm border border-base-200 p-4'
            : ['flex flex-wrap items-center gap-x-6 gap-y-2 py-3 px-1', showBorder && 'border-t border-base-200']
    ]}
>
    {isCard ? (
        <div class="flex flex-col gap-1">
            <p class="font-semibold text-base-content">{data.IngredientName}</p>
            {data.CasNumber && (
                <p class="text-sm text-base-content/60 font-mono">{data.CasNumber}</p>
            )}
            {data.Function && (
                <p class="text-sm text-base-content/70">{data.Function}</p>
            )}
            {data.OnDesignatedList?.html && (
                <div class="text-sm text-base-content/80 mt-1" set:html={data.OnDesignatedList.html} />
            )}
        </div>
    ) : (
        <>
            <span class="font-semibold text-base-content min-w-[8rem] flex-1">{data.IngredientName}</span>
            {data.CasNumber && (
                <span class="text-sm text-base-content/60 font-mono min-w-[6rem]">{data.CasNumber}</span>
            )}
            {data.Function && (
                <span class="text-sm text-base-content/70 min-w-[6rem]">{data.Function}</span>
            )}
            {data.OnDesignatedList?.html && (
                <span class="badge badge-ghost text-xs ml-auto" set:html={data.OnDesignatedList.html} />
            )}
        </>
    )}
</div>
