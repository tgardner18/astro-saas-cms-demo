---
import type { Locales } from 'astro';
import { format } from 'date-fns';
import type { IngredientDisclosurePageFragment } from '../../../../__generated/sdk';
import { getOptimizelySdk } from '../../../graphql/getSdk';
import type { ContentPayload } from '../../../graphql/shared/ContentPayload';
import Layout from '../../../layouts/Layout.astro';
import { isEditContext } from '../../shared/utils.ts';

const isCmsEdit = isEditContext(Astro.url);

export interface Props {
    contentPayload: ContentPayload;
}
const { contentPayload } = Astro.props as Props;

const optiResponse = await getOptimizelySdk(contentPayload).ingredientDisclosurePageById({
    key: contentPayload.key,
    //@ts-ignore
    loc: contentPayload.loc as Locales,
    ver: contentPayload.ver,
});
const post = optiResponse?.IngredientDisclosurePage?.item as IngredientDisclosurePageFragment;

// Collect all ingredient keys from the broken ContentReference.item link index
// and fetch them directly by key instead, bypassing the stale link resolution
const ingredientKeys = (post?.IntentionallyAddedIngredients ?? [])
    .map((ref: any) => ref?.key).filter(Boolean);
const fragranceKeys = (post?.FragranceComponents ?? [])
    .map((ref: any) => ref?.key).filter(Boolean);
const allKeys = [...new Set([...ingredientKeys, ...fragranceKeys])];

const entriesResponse = allKeys.length > 0
    ? await getOptimizelySdk(contentPayload).getIngredientEntriesByKeys({
        keys: allKeys,
        //@ts-ignore
        loc: contentPayload.loc as Locales,
    })
    : null;

const entryMap = new Map(
    (entriesResponse?.IngredientEntry?.items ?? [])
        .filter(Boolean)
        .map((entry: any) => [entry._metadata?.key, entry])
);

const disclosureDate = post?.DisclosureDate
    ? format(new Date(post.DisclosureDate), 'yyyy-MM-dd')
    : null;

const graphType = post?.SeoSettings?.GraphType && post?.SeoSettings?.GraphType !== '-'
    ? post?.SeoSettings?.GraphType : 'website';
const defaultUrl = post?._metadata?.url?.default || '';
const hierarchicalUrl = post?._metadata?.url?.type === 'SIMPLE' ? post?._metadata?.url?.hierarchical : '';

const pageTitle = post?.ProductName || post?._metadata?.displayName || 'Ingredient Disclosure';
const subVariant = post?._metadata?.displayName && post?._metadata?.displayName !== post?.ProductName
    ? post?._metadata?.displayName
    : null;

type IngredientRow = {
    _metadata?: { key?: string | null } | null;
    IngredientName?: string | null;
    CasNumber?: string | null;
    Function?: string | null;
    OnDesignatedList?: { html?: string | null } | null;
};

const ingredients = ingredientKeys
    .map((key: string) => entryMap.get(key))
    .filter(Boolean) as IngredientRow[];
const fragranceComponents = fragranceKeys
    .map((key: string) => entryMap.get(key))
    .filter(Boolean) as IngredientRow[];

const materialNumbers = ((post?.MaterialNumbers ?? []).filter(Boolean) as string[]);

const pageClass = 'page-ingredient-disclosure';
---

<Layout
    title={post?.SeoSettings?.MetaTitle ?? pageTitle}
    description={post?.SeoSettings?.MetaDescription ?? pageTitle}
    graphtype={graphType}
    indexing={post?.SeoSettings?.Indexing ?? false}
    contentPayload={contentPayload}
    defaultUrl={defaultUrl}
    hierarchicalUrl={hierarchicalUrl ?? ''}
    extPreviewEnabled={false}
>
    <div class={`max-w-screen-6xl mx-auto ${pageClass}`}>
        <main class="py-13 pb-18">
            <div class="mx-auto max-w-screen-xl px-8 2xl:px-0">

                {/* Document header */}
                <header class="mb-9 id-reveal">
                    <span class="id-eyebrow border-l-[3px] border-accent pl-3">Church &amp; Dwight · Product Ingredient Disclosure</span>
                    <h1
                        class="text-[30px] font-extrabold text-primary leading-tight"
                        data-epi-edit={isCmsEdit ? 'ProductName' : undefined}
                    >
                        {pageTitle}
                    </h1>
                    {subVariant && (
                        <p class="text-lg text-base-content/60 mt-1.5">{subVariant}</p>
                    )}
                </header>

                {/* Product Details card */}
                <div class="id-card id-reveal mb-8">
                    <div class="bg-primary px-[22px] py-[13px]">
                        <span class="text-[11px] font-bold tracking-[.12em] text-primary-content/85 uppercase">
                            Product Details
                        </span>
                    </div>
                    <dl class="divide-y divide-[#dde1e9]">
                        <div class="flex items-baseline gap-4 px-[22px] py-[15px]">
                            <dt class="id-meta-label">Category</dt>
                            <dd
                                class="text-[15px] font-semibold text-base-content"
                                data-epi-edit={isCmsEdit ? 'ProductCategory' : undefined}
                            >
                                {post?.ProductCategory}
                            </dd>
                        </div>
                        {materialNumbers.length > 0 && (
                            <div class="flex items-baseline gap-4 px-[22px] py-[15px]">
                                <dt class="id-meta-label">Material No.</dt>
                                <dd
                                    class="flex flex-wrap gap-1.5"
                                    data-epi-edit={isCmsEdit ? 'MaterialNumbers' : undefined}
                                >
                                    {materialNumbers.map((num) => (
                                        <span class="id-chip border border-[#dde1e9] bg-[#f2f3f5] text-primary font-bold rounded-full font-mono text-[13px] px-3 py-1">{num}</span>
                                    ))}
                                </dd>
                            </div>
                        )}
                    </dl>
                </div>

                {/* Intentionally Added Ingredients table */}
                {ingredients.length > 0 && (
                    <div class="id-card id-reveal mb-8">
                        <div class="bg-primary px-[22px] py-[13px]">
                            <span class="text-[11px] font-bold tracking-[.12em] text-primary-content/85 uppercase">
                                Intentionally Added Ingredients
                            </span>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="id-table w-full border-collapse">
                                <thead>
                                    <tr class="id-thead-row">
                                        <th class="id-th" style="width:34%">Ingredient</th>
                                        <th class="id-th" style="width:17%">CAS #</th>
                                        <th class="id-th" style="width:20%">Function</th>
                                        <th class="id-th" style="width:29%">Designated List</th>
                                    </tr>
                                </thead>
                                <tbody
                                    data-epi-edit={isCmsEdit ? 'IntentionallyAddedIngredients' : undefined}
                                >
                                    {ingredients.map((ing) => (
                                        <tr
                                            class="border-b border-base-200 hover:bg-base-100 transition-colors"
                                            data-epi-block-id={isCmsEdit && ing._metadata?.key || undefined}
                                        >
                                            <td class="id-td" data-label="Ingredient">
                                                <span class="id-ingredient-name">{ing.IngredientName}</span>
                                            </td>
                                            <td class="id-td id-cas" data-label="CAS #">
                                                {ing.CasNumber ?? <span class="italic text-base-content/40">N/A</span>}
                                            </td>
                                            <td class="id-td id-fn" data-label="Function">{ing.Function}</td>
                                            <td class="id-td" data-label="Designated List">
                                                <div class="designated-list-cell text-primary" set:html={ing.OnDesignatedList?.html} />
                                            </td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    </div>
                )}

                {/* Fragrance Components table */}
                {fragranceComponents.length > 0 && (
                    <div class="id-card id-reveal mb-8">
                        <div class="bg-primary px-[22px] py-[13px] flex items-center justify-between">
                            <span class="text-[11px] font-bold tracking-[.12em] text-primary-content/85 uppercase">
                                Fragrance Components
                            </span>
                            <span class="text-[11px] text-primary-content/50">
                                At or above 100 ppm, or on a designated list
                            </span>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="id-table w-full border-collapse">
                                <thead>
                                    <tr class="id-thead-row">
                                        <th class="id-th" style="width:44%">Component</th>
                                        <th class="id-th" style="width:18%">CAS #</th>
                                        <th class="id-th" style="width:38%">Designated List</th>
                                    </tr>
                                </thead>
                                <tbody
                                    data-epi-edit={isCmsEdit ? 'FragranceComponents' : undefined}
                                >
                                    {fragranceComponents.map((frag) => (
                                        <tr
                                            class="border-b border-base-200 hover:bg-base-100 transition-colors"
                                            data-epi-block-id={isCmsEdit && frag._metadata?.key || undefined}
                                        >
                                            <td class="id-td" data-label="Component">
                                                <span class="id-ingredient-name">{frag.IngredientName}</span>
                                            </td>
                                            <td class="id-td id-cas" data-label="CAS #">
                                                {frag.CasNumber ?? <span class="italic text-base-content/40">N/A</span>}
                                            </td>
                                            <td class="id-td" data-label="Designated List">
                                                <div class="designated-list-cell" set:html={frag.OnDesignatedList?.html} />
                                            </td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    </div>
                )}

                {/* Footer: SDS link + Disclosure date */}
                <div class="flex items-end justify-between border-t-2 border-base-200 pt-8 flex-wrap gap-5 id-reveal">
                    {post?.SdsLink?.url?.default ? (
                        <div>
                            <p class="id-footer-label">Safety Data Sheet</p>
                            <a
                                href={post.SdsLink.url.default}
                                target={post.SdsLink.target ?? '_blank'}
                                rel="noopener noreferrer"
                                class="id-footer-link border-b-2 border-accent pb-px"
                                data-epi-edit={isCmsEdit ? 'SdsLink' : undefined}
                            >
                                {post.SdsLink.text ?? 'View SDS Document'} ↗
                            </a>
                        </div>
                    ) : <div />}

                    {disclosureDate && (
                        <div class="text-right">
                            <p class="id-footer-label">Date of Disclosure</p>
                            <p
                                class="font-mono text-[17px] font-bold text-primary"
                                data-epi-edit={isCmsEdit ? 'DisclosureDate' : undefined}
                            >
                                {disclosureDate}
                            </p>
                        </div>
                    )}
                </div>

            </div>
        </main>
    </div>
</Layout>

<style is:global>
  /* ── Stagger fade-in ── */
  @keyframes id-fadeUp {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .page-ingredient-disclosure .id-reveal {
    animation: id-fadeUp .4s ease both;
  }
  .page-ingredient-disclosure .id-reveal:nth-child(1) { animation-delay: .05s; }
  .page-ingredient-disclosure .id-reveal:nth-child(2) { animation-delay: .12s; }
  .page-ingredient-disclosure .id-reveal:nth-child(3) { animation-delay: .19s; }
  .page-ingredient-disclosure .id-reveal:nth-child(4) { animation-delay: .26s; }
  .page-ingredient-disclosure .id-reveal:nth-child(5) { animation-delay: .33s; }

  /* ── Card shell ── */
  .page-ingredient-disclosure .id-card {
    background: #ffffff;
    border: 1px solid #dde1e9;
    border-radius: 10px;
    box-shadow: 0 1px 4px rgba(0,0,0,.07), 0 2px 12px rgba(0,0,0,.05);
    overflow: hidden;
  }

  /* ── Shared primitives ── */
  .page-ingredient-disclosure .id-eyebrow {
    display: inline-block;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: oklch(var(--p));
    margin-bottom: 14px;
  }

  .page-ingredient-disclosure .id-meta-label {
    flex-shrink: 0;
    width: 140px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: oklch(var(--bc) / 0.5);
  }

  /* Material number chips — Tailwind classes handle color/border/shape */
  .page-ingredient-disclosure .id-chip {
    display: inline-block;
  }

  /* Table header row */
  .page-ingredient-disclosure .id-thead-row {
    background: #f0f2f7;
    border-bottom: 2px solid oklch(var(--p));
  }

  /* Table headers */
  .page-ingredient-disclosure .id-th {
    padding: 12px 18px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: oklch(var(--p));
    text-align: left;
    white-space: nowrap;
  }

  /* Table body rows */
  .page-ingredient-disclosure tbody tr {
    border-bottom: 1px solid #dde1e9;
    transition: background .12s;
  }
  .page-ingredient-disclosure tbody tr:last-child {
    border-bottom: none;
  }
  .page-ingredient-disclosure tbody tr:hover {
    background: #f5f7fc;
  }

  /* Table cells */
  .page-ingredient-disclosure .id-td {
    padding: 14px 18px;
    vertical-align: middle;
    font-size: 15px;
  }

  /* CAS number cell */
  .page-ingredient-disclosure .id-cas {
    font-family: 'Courier New', monospace;
    font-size: 15px;
    font-weight: 700;
    color: #000000;
    white-space: nowrap;
  }

  /* Function cell */
  .page-ingredient-disclosure .id-fn {
    color: oklch(var(--bc) / 0.6);
    font-size: 15px;
  }

  /* Ingredient / component name */
  .page-ingredient-disclosure .id-ingredient-name {
    font-weight: 700;
    color: #0067B0;
  }

  /* Footer */
  .page-ingredient-disclosure .id-footer-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: oklch(var(--bc) / 0.5);
    margin-bottom: 6px;
  }

  .page-ingredient-disclosure .id-footer-link {
    font-size: 15px;
    font-weight: 700;
    color: oklch(var(--p));
    text-decoration: none;
    transition: color .15s;
  }
  .page-ingredient-disclosure .id-footer-link:hover {
    color: oklch(var(--er));
    opacity: 1;
  }

  /* ── Designated list badges ── */
  .page-ingredient-disclosure .designated-list-cell {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    align-items: flex-start;
  }

  /* Paragraphs wrapping links become transparent flex pass-throughs */
  .page-ingredient-disclosure .designated-list-cell p:has(a) {
    margin: 0;
    display: contents;
  }

  /* Paragraphs with plain text ("No") styled as the neutral badge */
  .page-ingredient-disclosure .designated-list-cell p:not(:has(a)) {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13.5px;
    font-weight: 600;
    border-radius: 99px;
    padding: 5px 12px 5px 8px;
    background: #f2f3f5;
    border: 1px solid #dde1e9;
    cursor: default;
  }
  .page-ingredient-disclosure .designated-list-cell p:not(:has(a))::before {
    content: '';
    display: block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #bbbbbb;
    flex-shrink: 0;
  }

  /* Base badge shape for all linked badges */
  .page-ingredient-disclosure .designated-list-cell a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13.5px;
    font-weight: 700;
    border-radius: 99px;
    padding: 5px 12px 5px 8px;
    white-space: nowrap;
    text-decoration: none;
    transition: filter .15s, box-shadow .15s;
  }
  .page-ingredient-disclosure .designated-list-cell a::before {
    content: '';
    display: block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .page-ingredient-disclosure .designated-list-cell a::after {
    content: '↗';
    font-size: 0.65em;
    line-height: 1;
    opacity: .7;
    flex-shrink: 0;
  }
  .page-ingredient-disclosure .designated-list-cell a:hover {
    filter: brightness(.94);
    box-shadow: 0 2px 8px rgba(0,0,0,.12);
    opacity: 1;
  }

  /* California (oehha.ca.gov, arb.ca.gov) — amber */
  .page-ingredient-disclosure .designated-list-cell a[href*="oehha.ca.gov"],
  .page-ingredient-disclosure .designated-list-cell a[href*="arb.ca.gov"] {
    background: linear-gradient(135deg, #fff8ec 0%, #fef0d0 100%);
    color: #6b3d00;
    border: 1px solid #f5d48a;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.7);
  }
  .page-ingredient-disclosure .designated-list-cell a[href*="oehha.ca.gov"]::before,
  .page-ingredient-disclosure .designated-list-cell a[href*="arb.ca.gov"]::before { background: #F0A321; }

  /* EU CMR (CELEX:32008R1272) — red */
  .page-ingredient-disclosure .designated-list-cell a[href*="32008R1272"] {
    background: linear-gradient(135deg, #fff4f5 0%, #fde8eb 100%);
    color: #8a0820;
    border: 1px solid #f0bdc6;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.7);
  }
  .page-ingredient-disclosure .designated-list-cell a[href*="32008R1272"]::before { background: #BA0C2F; }

  /* EU Fragrance Allergens (CELEX:32009R1223) — purple */
  .page-ingredient-disclosure .designated-list-cell a[href*="32009R1223"] {
    background: linear-gradient(135deg, #f8f2fd 0%, #ede0f8 100%);
    color: #4a1980;
    border: 1px solid #c9aeea;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.7);
  }
  .page-ingredient-disclosure .designated-list-cell a[href*="32009R1223"]::before { background: #61279E; }

  /* EPA PBTs (epa.gov) — magenta */
  .page-ingredient-disclosure .designated-list-cell a[href*="epa.gov"] {
    background: linear-gradient(135deg, #fef2fb 0%, #f8ddf4 100%);
    color: #870069;
    border: 1px solid #e8a8d8;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.7);
  }
  .page-ingredient-disclosure .designated-list-cell a[href*="epa.gov"]::before { background: #B4008E; }

  /* Generic fallback for other linked badges — primary blue */
  .page-ingredient-disclosure .designated-list-cell a:not([href*="oehha.ca.gov"]):not([href*="arb.ca.gov"]):not([href*="32008R1272"]):not([href*="32009R1223"]):not([href*="epa.gov"]) {
    background: oklch(var(--p) / 0.08);
    color: oklch(var(--p));
    border: 1px solid oklch(var(--p) / 0.25);
  }
  .page-ingredient-disclosure .designated-list-cell a:not([href*="oehha.ca.gov"]):not([href*="arb.ca.gov"]):not([href*="32008R1272"]):not([href*="32009R1223"]):not([href*="epa.gov"])::before {
    background: oklch(var(--p));
  }

  /* ── Mobile stacked table layout ── */
  @media (max-width: 639px) {
    .page-ingredient-disclosure .id-table thead {
      display: none;
    }
    .page-ingredient-disclosure .id-table tbody tr {
      display: block;
      padding: 12px 18px;
    }
    .page-ingredient-disclosure .id-table tbody tr:last-child {
      border-bottom: none;
    }
    .page-ingredient-disclosure .id-table .id-td {
      display: flex;
      align-items: baseline;
      gap: 10px;
      padding: 6px 0;
      font-size: 14px;
    }
    .page-ingredient-disclosure .id-table .id-td::before {
      content: attr(data-label);
      flex-shrink: 0;
      width: 110px;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: oklch(var(--bc) / 0.45);
    }
  }
</style>
