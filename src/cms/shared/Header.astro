---
import { Image as AstroImage } from 'astro:assets';

import { getRelativeLocaleUrl } from 'astro:i18n';
import type { SiteSettingsByHostnameQuery, Locales } from '../../../__generated/sdk';
import type { ContentPayload } from '../../graphql/shared/ContentPayload';
import { localeToSdkLocale } from '../../lib/locale-helpers';
import { getClassForLogo } from './siteSettingsHelper';
import SearchPaletteV2 from './SearchPaletteV2.svelte';
import ThemePicker from './ThemePicker.astro';
import LocaleSelector from './LocaleSelector.astro';
import HeaderDrawerMenuButton from './HeaderDrawerMenuButton.astro';
import HeaderMobileDropdownNav from './HeaderMobileDropdownNav.astro';
import HeaderDesktopHorizontalNav from './HeaderDesktopHorizontalNav.astro';
import HeaderDrawerNavigation from './HeaderDrawerNavigation.astro';
import type { MenuItemType } from './headerNavigationTypes';

const lang = Astro.currentLocale;

interface Props {
    siteSettings: SiteSettingsByHostnameQuery;
    contentPayload?: ContentPayload;
}

const { siteSettings, contentPayload: providedContentPayload } = Astro.props;

// Use provided contentPayload if available, otherwise create minimal one
const contentPayload: ContentPayload = providedContentPayload || {
    ctx: 'view',
    key: '',
    ver: '',
    loc: localeToSdkLocale(lang || 'en') as Locales,
    preview_token: '',
    types: [],
};
const settings = siteSettings?.SiteSettings?.item;

const topNavStyle = settings?.TopNavStyle || 'standard';
// Backward compatibility: treat old "drawer" value as "drawer-left"
const normalizedTopNavStyle = topNavStyle === 'drawer' ? 'drawer-left' : topNavStyle;
const isDrawerMode = normalizedTopNavStyle === 'drawer-left' || normalizedTopNavStyle === 'drawer-right';
const isDrawerRight = normalizedTopNavStyle === 'drawer-right';
const logoUrl = (settings?.Logo as any)?.item?.Url || settings?.Logo?.url?.default || null;
const logoCss = getClassForLogo(settings?.LogoResolution);

const headerItems = settings?.HeaderLinks as MenuItemType[] | undefined;
---

<header class="sticky top-0 z-50 bg-gray-50/70 backdrop-blur-sm">
    <div class="navbar bg-base-100 shadow-sm">
        <div class="navbar-start">
            <!-- Navigation: Standard Mobile or Drawer Left -->
            {!isDrawerMode ? (
                <HeaderMobileDropdownNav headerItems={headerItems} />
            ) : !isDrawerRight ? (
                <HeaderDrawerMenuButton direction="left" />
            ) : null}

            <!-- Logo -->
            <a
                class="block px-8 text-teal-600"
                href={getRelativeLocaleUrl(lang, '/')}
            >
                <span class="sr-only">Home</span>
                <AstroImage
                    class:list={[logoCss, "w-full object-contain max-w-full"]}
                    src={logoUrl ?? '/optimizely-logo.svg'}
                    alt="Logo"
                    width=300
                    height=300
                />
            </a>
        </div>

        <!-- Desktop Navigation: Only show when NOT in drawer mode -->
        {!isDrawerMode && <HeaderDesktopHorizontalNav headerItems={headerItems} />}

        <!-- Right Side Actions -->
        <div class="navbar-end" x-data>
            <!-- Search input -->
            <div class="relative hidden lg:block">
                <input
                    id="search-input"
                    type="text"
                    placeholder="Search... (⌘K / Ctrl+K)"
                    class="input input-bordered input-sm w-44 pl-10 pr-4"
                    readonly
                    @click="$dispatch('open-command-palette')"
                />
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
                    ></path>
                </svg>
            </div>
            <!-- Search button -->
            <button
                id="search-button"
                @click="$dispatch('open-command-palette')"
                class="btn btn-ghost btn-circle lg:hidden"
                aria-label="Search"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="h-5 w-5"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
                    ></path>
                </svg>
            </button>
            <!-- Locale selector -->
            <LocaleSelector contentPayload={contentPayload} />
            <!-- Theme switcher dropdown -->
            <ThemePicker />
            <!-- Auth: logged-in pill + sign out OR login button -->
            <div x-data class="flex items-center gap-2">
                <template x-if="$store.auth?.isLoggedIn">
                    <div class="flex items-center gap-2">
                        <span class="badge badge-success badge-lg font-semibold whitespace-nowrap">Bank Member</span>
                        <button
                            @click="$store.auth.logout()"
                            class="btn btn-ghost btn-sm text-sm"
                        >Sign Out</button>
                    </div>
                </template>
                <template x-if="!$store.auth?.isLoggedIn">
                    <button
                        @click="$store.auth.modalOpen = true"
                        class="btn btn-sm"
                    >Log In</button>
                </template>
            </div>
            <!-- Drawer Right mode: Hamburger button on ALL breakpoints (RIGHT side, after login) -->
            {isDrawerRight && <HeaderDrawerMenuButton direction="right" />}
        </div>
    </div>
</header>

<!-- Drawer Navigation Component -->
{isDrawerMode && <HeaderDrawerNavigation headerItems={headerItems} isDrawerRight={isDrawerRight} />}

<!-- Search Palette Component -->
<SearchPaletteV2 client:load currentLocale={lang} domain={Astro.url.origin} />

<!-- Keyboard shortcut for search -->
<script is:inline>
    document.addEventListener('keydown', function(e) {
        // Cmd+K (Mac) or Ctrl+K (Windows/Linux)
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
            e.preventDefault();
            window.dispatchEvent(new CustomEvent('open-command-palette'));
        }
    });
</script>

<!-- ABA Login Modal -->
<div
    x-data
    x-show="$store.auth?.modalOpen"
    x-effect="document.body.classList.toggle('overflow-hidden', !!$store.auth?.modalOpen)"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    @keydown.escape.window="$store.auth.modalOpen = false"
    class="fixed inset-0 z-[200] flex items-center justify-center p-4"
    style="display: none;"
>
    <!-- Backdrop -->
    <div
        class="absolute inset-0 bg-black/60 backdrop-blur-sm"
        @click="$store.auth.modalOpen = false"
    ></div>

    <!-- Modal panel -->
    <div class="relative z-10 w-full max-w-3xl rounded-2xl overflow-hidden shadow-2xl flex min-h-[480px]">

        <!-- Left: ABA branded panel -->
        <div
            class="hidden md:flex flex-col justify-between w-5/12 p-8 text-white"
            style="background-color: #003b71; background-image: url('https://www.aba.com/~/media/aba/images/backgrounds/background-pattern__dark-gray2x.png'); background-repeat: repeat; background-blend-mode: multiply;"
        >
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <img src="/ABA-white.png" alt="ABA" class="h-8 w-auto object-contain" />
                </div>
                <p class="text-xs font-medium text-white/60 tracking-widest uppercase">American Bankers Association</p>
            </div>

            <div class="space-y-4">
                <div class="w-10 h-1 bg-white/30 rounded-full"></div>
                <h2 class="text-2xl font-bold leading-snug">
                    Your gateway to banking resources &amp; events.
                </h2>
                <p class="text-sm text-white/70 leading-relaxed">
                    Access exclusive member content, webinars, professional training, and ABA member resources.
                </p>
            </div>

            <p class="text-xs text-white/30">&copy; American Bankers Association</p>
        </div>

        <!-- Right: Login form -->
        <div class="flex-1 bg-white flex flex-col justify-center p-8 md:p-10 relative">
            <!-- Close -->
            <button
                @click="$store.auth.modalOpen = false"
                class="absolute top-4 right-4 btn btn-ghost btn-sm btn-circle text-gray-400 hover:text-gray-600"
                aria-label="Close modal"
            >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>

            <div class="max-w-xs mx-auto w-full space-y-6">
                <!-- ABA mark (mobile only) -->
                <div class="md:hidden">
                    <p class="text-xs font-semibold tracking-widest text-gray-400 uppercase">American Bankers Association</p>
                </div>

                <div>
                    <h2 class="text-2xl font-bold text-gray-900 mb-2">Sign In</h2>
                    <p class="text-sm text-gray-500 leading-relaxed">
                        Sign in to register for events, purchase most products, and access online training and content where eligible.
                        ABA Membership is required to view designated member resources.
                    </p>
                </div>

                <button
                    @click="$store.auth.login()"
                    class="btn w-full text-white font-semibold border-none hover:opacity-90 transition-opacity"
                    style="background-color: #003b71;"
                >
                    Continue as ABA Bank Member
                </button>

                <div class="border-t border-gray-100 pt-4">
                    <p class="text-xs text-gray-400 leading-relaxed text-center">
                        <span class="font-semibold text-gray-500">Demo only &mdash;</span> This simulates an authentication
                        flow against ABA&rsquo;s Association Management System (AMS).
                        No real credentials are required or stored.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>